# Dashboard
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Private extension and scheduled collectors
# CRON_SECRET is optional in production. When omitted, the server verifies the
# bearer token against the generated Supabase Vault secret.
CRON_SECRET=
DEV_EXTENSION_TOKEN=replace-with-a-random-local-token
SEATGEEK_CLIENT_ID=
STUBHUB_CLIENT_ID=
STUBHUB_CLIENT_SECRET=
STUBHUB_SCOPE=read:events
# Set only to the listing endpoint template documented for your approved account.
# The placeholder is required, for example: https://.../events/{eventId}/listings
STUBHUB_LISTINGS_URL_TEMPLATE=
TICKPICK_FEED_URL=
TICKPICK_FEED_TOKEN=
# Optional authorized export/feed using the cross-platform mapping contract.
MARKETPLACE_MAPPING_FEED_URL=
MARKETPLACE_MAPPING_FEED_TOKEN=

# Crawlee worker (runs separately from Vercel)
TICKET_AGENT_API_BASE_URL=http://localhost:3000
TICKET_AGENT_EXTENSION_TOKEN=
TICKET_AGENT_WORKER_HORIZON_DAYS=14
TICKET_AGENT_WORKER_MAX_CONCURRENCY=2
TICKET_AGENT_WORKER_MAX_JOBS=8
TICKET_AGENT_WORKER_HEADLESS=true
TICKET_AGENT_WORKER_BROWSER_CHANNEL=
# Uploads are disabled until this is explicitly changed to false.
TICKET_AGENT_WORKER_DRY_RUN=true

# Email
RESEND_API_KEY=
RESEND_FROM_EMAIL=Braves Ticket Scanner <alerts@example.com>

# Optional Telegram phone alerts
# Create a bot with @BotFather, message it once, then use the numeric chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: require auth even when Supabase is not configured
REQUIRE_AUTH=false
ALLOWED_EMAIL=
UNSUBSCRIBE_SECRET=
